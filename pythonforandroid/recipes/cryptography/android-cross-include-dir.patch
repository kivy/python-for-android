+    // p4a: when cross-compiling for Android, `python` here is the host
+    // (native, non-Android) Python used to run build tooling -- asking it
+    // for its own include_dirs via setuptools returns the *host's*
+    // Python.h, not the Android target's, which fails CPython's LONG_BIT
+    // sanity check when compiled for a different word size/ABI. Let the
+    // p4a recipe override this explicitly with the target's include dir.
+    let python_includes = match env::var("P4A_PYTHON_INCLUDE_DIR") {
